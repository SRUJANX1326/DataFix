# Copy to .env for local dev. On Vercel add the same names under Project → Settings → Environment Variables.
# NEVER commit real keys. These are read only by /api serverless functions (never exposed to the browser).
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional – Supabase (to save run history). Use the service_role key; it stays on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
# Alternatively use SUPABASE_SERVICE_ROLE_KEY (same value)
